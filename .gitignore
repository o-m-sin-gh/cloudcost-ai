# ---------- Secrets and credentials (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*accessKeys*
.aws/

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*

# ---------- Local app data (may contain AWS account IDs and function names) ----------
data/*/*.json
data/*/*.csv
data/settings.json
reports/*.csv
reports/*.json
reports/*.pdf
