!**/.gitkeep

# ---------- Logs ----------
*.log
logs/

# ---------- Editors and OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Build / packaging leftovers ----------
*.zip
*.tar.gz